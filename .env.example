# Firebase console > Project settings > General > Web app > SDK configuration.
# These VITE_* values are public and are included in the browser bundle.
# Never put service-account credentials, OAuth tokens, or Sheets secrets here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=gdsc-homecomming
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional. Setting this does not enable Analytics.
VITE_FIREBASE_MEASUREMENT_ID=
