{
  "name": "gdsc-homecomming",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc -b",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --exact-port --no-open",
    "build-storybook": "storybook build",
    "test": "bun test tests",
    "emulators": "firebase emulators:start --project demo-gdg-homecoming --only firestore",
    "test:firebase": "firebase emulators:exec --project demo-gdg-homecoming --only firestore \"bun test tests\"",
    "dev:emulator": "VITE_TICKET_SERVICE=firebase VITE_USE_FIREBASE_EMULATORS=true vite --port 5174 --strictPort",
    "emulators:seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 bun scripts/seed-emulator.mjs",
    "roster:import": "bun scripts/import-roster.mjs",
    "deploy:firebase": "bun scripts/deploy-firebase.mjs",
    "deploy:ci": "gh workflow run firebase-deploy.yml --repo HyeokE/gdsc-homecoming --ref main",
    "deploy:ci:status": "gh run list --repo HyeokE/gdsc-homecoming --workflow firebase-deploy.yml --limit 5",
    "setup:firebase-ci": "bun scripts/configure-firebase-ci.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^13.0.0",
    "html-to-image": "^1.11.13",
    "motion": "^14.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.33.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "10.6.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.13.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,css,html,md,yml,yaml}": "prettier --write"
  }
}
