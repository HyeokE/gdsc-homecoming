{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    },
    "singleProjectMode": false
  },
  "hosting": [
    {
      "site": "gdsc-homecoming",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "gdsc-homecomming",
      "redirects": [
        {
          "source": "/",
          "destination": "https://gdsc-homecoming.web.app/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://gdsc-homecoming.web.app/:path",
          "type": 301
        }
      ]
    }
  ]
}
